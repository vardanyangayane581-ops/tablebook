# Պատճենեք այս ֆայլը .env անունով և լրացրեք արժեքները։
# .env ֆայլը չպետք է հայտնվի git-ում։

# Սեսիայի գաղտնի բանալի՝ երկար պատահական տող։ Ստեղծելու համար՝
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Սերվերի պորտը (ըստ ցանկության)
PORT=3000

# Ադմին վահանակի միակ աշխատողը (օրինակային տվյալներ, փոխեք ձերով)
ADMIN_NAME=Աննա Ադմին
ADMIN_EMAIL=admin@tablebook.example
ADMIN_PASSWORD=Admin-Demo-2026

# Քարտով վճարումների գաղտնի բանալի (32+ նիշ)՝ նույն հրամանով ստեղծված պատահական տող։
# Քարտի ամբողջական համարը երբեք չի պահվում. այս բանալիով ստեղծվում է միայն
# քարտի «մատնահետքը» (HMAC), որից համարը հնարավոր չէ վերականգնել։
# Եթե բանալին նշված չէ, կայքում հասանելի կլինի միայն կանխիկ վճարումը։
PAYMENT_SECRET=
